{
  "name": "kompetensportalen",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview --host 0.0.0.0",
    "test": "npm run build && node --test tests/vite-edge.test.mjs",
    "db:generate:supabase": "drizzle-kit generate --config drizzle.supabase.config.ts",
    "db:migrate:supabase": "drizzle-kit migrate --config drizzle.supabase.config.ts",
    "migrate:sqlite:supabase": "node scripts/migrate-sqlite-to-supabase.mjs",
    "migration:report": "node --import tsx scripts/import-odoo-course.mjs",
    "migration:normalize-csv": "node --import tsx scripts/normalize-odoo-csv.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router-dom": "^7.6.3",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
